{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Talking-head analysis for an editorial LLM",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "input_id", "analysis_complete", "duration_ms", "brief", "units"],
  "properties": {
    "version": {"const": "1.0"},
    "input_id": {"type": "string", "minLength": 1},
    "analysis_complete": {"type": "boolean"},
    "duration_ms": {"type": "integer", "minimum": 1},
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "audience", "style", "allow_reorder", "target_duration_ms", "duration_tolerance_ms", "required_unit_ids"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "style": {"enum": ["conservative", "balanced", "tight"]},
        "allow_reorder": {"type": "boolean"},
        "target_duration_ms": {"type": ["integer", "null"], "minimum": 1},
        "duration_tolerance_ms": {"type": "integer", "minimum": 0},
        "required_unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_ms", "end_ms", "kind", "text", "speaker", "speech_confidence", "boundary_quality", "visual_description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["speech", "silence", "non_speech"]},
          "text": {"type": "string"},
          "speaker": {"type": ["string", "null"]},
          "speech_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "boundary_quality": {"enum": ["candidate", "uncertain"]},
          "visual_description": {"type": ["string", "null"]}
        }
      }
    }
  }
}
