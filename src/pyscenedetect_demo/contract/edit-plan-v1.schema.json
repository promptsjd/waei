{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Talking-head edit decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "input_id", "status", "summary", "sequence", "removed", "joins", "review_items"],
  "properties": {
    "version": {"const": "1.0"},
    "input_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "needs_review"]},
    "summary": {"type": "string", "minLength": 1},
    "sequence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unit_ids", "reason"],
        "properties": {
          "unit_ids": {"$ref": "#/$defs/nonempty_ids", "description": "Retained units in intended output order. The tool splits source ranges at gaps without including omitted units."},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unit_id", "reason_code", "reason"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "reason_code": {"enum": ["false_start", "duplicate_take", "filler", "excessive_pause", "off_topic", "technical_problem", "not_selected"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "joins": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from_index", "to_index", "transition", "review_required", "note"],
        "properties": {
          "from_index": {"type": "integer", "minimum": 0},
          "to_index": {"type": "integer", "minimum": 1},
          "transition": {"const": "cut"},
          "review_required": {"type": "boolean"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "review_items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["unit_ids", "issue_code", "note"],
        "properties": {
          "unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "issue_code": {"enum": ["incomplete_analysis", "uncertain_transcript", "uncertain_boundary", "meaning_risk", "join_risk", "target_unmet", "insufficient_material", "finer_segmentation_needed"]},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "nonempty_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
