{
  "name": "WAIE browser trial",
  "build": {"dockerfile": "Dockerfile"},
  "remoteUser": "vscode",
  "hostRequirements": {"cpus": 2, "memory": "8gb", "storage": "32gb"},
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {"label": "WAIE", "onAutoForward": "notify"}
  },
  "postCreateCommand": "python tools/codespace.py setup",
  "postStartCommand": "python tools/codespace.py start",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "settings": {"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"}
    }
  }
}
